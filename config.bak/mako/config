font=Hack Nerd Font 12
background-color=#ffffff
text-color=#000000
width=450
height=400
margin=10
padding=10
border-size=2
border-color=#000000
border-radius=4
icons=1
max-icon-size=64
anchor=top-right
default-timeout=10000
layer=overlay

max-visible=5

# Show more text before truncating
format=<b>%s</b>\n%b

[urgency=critical]
background-color=#000000
text-color=#ffffff
border-color=#000000

[mode=dark]

# Mako Notification Daemon Configuration
# Matrix Green Theme (10% Dimmer Colors)

font=Hack Nerd Font 12
background-color=#000000
text-color=#4AB34D
width=450
height=400
margin=10
padding=10
border-size=2
border-color=#4AB34D
border-radius=4
icons=1
max-icon-size=64
anchor=top-right
default-timeout=10000
layer=overlay
max-visible=5
# Show more text before truncating
format=<b>%s</b>\n%b

# Low urgency notifications - darker green
[urgency=low mode=dark]
background-color=#000000
text-color=#2E9031
border-color=#207F23

# Normal urgency (default values above apply)
[urgency=normal mode=dark]
background-color=#000000
text-color=#4AB34D
border-color=#4AB34D

# Critical urgency - inverted with bright green
[urgency=critical mode=dark]
background-color=#4AB34D
text-color=#000000
border-color=#4AB34D
default-timeout=0

# Alternative critical style - keep black bg but brighter border
# [urgency=critical]
# background-color=#000000
# text-color=#4AB34D
# border-color=#3CA23F
# border-size=3
# default-timeout=0

# Color Reference:
# #000000 - Black (background)
# #045C07 - Deep Green (10% dimmer)
# #126D15 - Verse Green (10% dimmer)
# #207F23 - Web Forest Green (10% dimmer)
# #2E9031 - Wageningen Green (10% dimmer) - used for low urgency
# #3CA23F - American Green (10% dimmer)
# #4AB34D - Apple Green (10% dimmer) - main text color



