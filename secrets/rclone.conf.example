# Copy to secrets/rclone.conf and fill in the token.
#
# This is restic's transport to Yandex Disk -- restic has no native Yandex
# backend, so it spawns `rclone serve restic --stdio` and pipes to it. rclone
# only ever moves encrypted pack files; it never sees plaintext.
#
# client_id and client_secret are intentionally blank: rclone ships built-in
# defaults for Yandex and the docs say to leave both empty.
#
# Two ways to get the token:
#
#   1. `rclone config` -- interactive, opens a browser for Yandex consent and
#      writes this file for you. In a Claude Code session, run it as
#      `! rclone config` so the output lands in the conversation.
#
#   2. Reuse the OAuth token you minted for yandex-trash. Register an app at
#      https://oauth.yandex.com/ with cloud_api:disk.read and
#      cloud_api:disk.write, then paste its access token into the JSON below.
#      One consent flow covers both tools.
#
# Note the token JSON is a single line, quoted as shown. Yandex access tokens
# are long-lived but not perpetual -- if restic starts failing to reach the
# repository, an expired token is the first thing to check
# (`yandex-trash list` will report it plainly).

[yandex]
type = yandex
client_id =
client_secret =
token = {"access_token":"REPLACE_ME","token_type":"OAuth","expiry":"2027-01-01T00:00:00.000000000Z"}
