+---Return inlined virtual text within a column range on a row, sorted by col.
+---@param row integer
+---@param start_col integer
+---@param end_col integer
+---@return render.md.request.inline.Value[]
+function Inline:range(row, start_col, end_col)
+    local result = {} ---@type render.md.request.inline.Value[]
+    for _, value in ipairs(self.values[row] or {}) do
+        if value.col >= start_col and value.col < end_col then
+            result[#result + 1] = value
+        end
+    end
+    table.sort(result, function(a, b)
+        return a.col < b.col
+    end)
+    return result
+end
+
