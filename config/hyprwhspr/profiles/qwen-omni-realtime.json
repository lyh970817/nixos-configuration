{
  "$schema": "https://raw.githubusercontent.com/goodroot/hyprwhspr/main/share/config.schema.json",
  "transcription_backend": "realtime-ws",
  "websocket_provider": "custom",
  "websocket_url": "ws://127.0.0.1:8771",
  "websocket_model": "qwen3.5-omni-plus-realtime",
  "realtime_mode": "converse",
  "realtime_conversation_history": "session",
  "realtime_sample_rate": 16000,
  "realtime_timeout": 8,
  "recording_mode": "toggle",
  "use_hypr_bindings": true,
  "primary_shortcut": "SUPER+O",
  "cancel_shortcut": "SUPER+ESCAPE",
  "applications": {
    "foot": { "auto_paste": "ctrl+shift+v" },
    "foot-float": { "auto_paste": "ctrl+shift+v" },
    "foot-main": { "auto_paste": "ctrl+shift+v" }
  },
  "paste_mode": "ctrl",
  "prefer_clipboard_paste": true,
  "clipboard_clear_delay": 0.2,
  "filter_filler_words": true,
  "post_transcription_hook": null,
  "notification_timeout_ms": 0,
  "whisper_prompt": ""
}
