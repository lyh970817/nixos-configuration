.worktrees/
.pre-commit-config.yaml

# Claude Code EnterWorktree scratch checkouts (session-scoped, own nested .git)
.claude/worktrees/

# Nix build-result symlinks (nix build -o <name>); these point into
# /nix/store and installer ISOs can embed cleartext secrets.
result
result-*
# Ignore real secret files under secrets/, but keep *.example.* templates tracked
# (they carry no real secrets and document the expected files).
secrets/*
!secrets/*.example.yaml
!secrets/*.example.json

# Generated per-machine facts, never tracked
hardware-configuration.nix
local.nix

# Base Codex config contains machine-local paths and remains unmanaged
/dotfiles/codex/config.toml

# Regenerated fcitx5 keyboard-layout cache (lives inside the linked config dir)
dotfiles/fcitx5/conf/cached_layouts

# Runtime-generated artifacts inside the out-of-store-linked config dirs
# (mutable-configs.nix). Upstream skill/plugin *source* is tracked; caches,
# installed deps, and nested clones that tools create at runtime are not.
dotfiles/**/__pycache__/
dotfiles/**/*.pyc
dotfiles/**/node_modules/
dotfiles/**/.venv/
dotfiles/**/venv/
dotfiles/**/.pytest_cache/
dotfiles/**/.mypy_cache/
dotfiles/**/.ruff_cache/
dotfiles/**/*.egg-info/
dotfiles/**/.git/
dotfiles/**/.DS_Store
