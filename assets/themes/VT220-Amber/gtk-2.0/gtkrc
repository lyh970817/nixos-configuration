# Template. Colours are palette rung tokens, substituted from
# home/palettes.nix by the vt220Theme derivation in home/desktop/theming.nix.
# Do not write phosphor hex here.

gtk_color_scheme = "bg_color:@background@
fg_color:@foreground@
base_color:@background@
text_color:@foreground@
selected_bg_color:@secondaryText@
selected_fg_color:@hot@
tooltip_bg_color:@background@
tooltip_fg_color:@foreground@"

# gtkRC by delvalle26, GPL'd

style "default"
{ 
  GtkWidget::cursor-color = @text_color
  GtkWidget::secondary-cursor-color = "#ff0000"
  GtkWidget::cursor-aspect-ratio = 0.10
  GtkWidget::link-color = "@bright@"
  GtkWidget::visited-link-color = "#555555"   

  GtkTreeView::odd-row-color = "@background@"
  NautilusIconContainer::selection_box_color = @fg_color 

  bg[ACTIVE]      = @bg_color 
  bg[INSENSITIVE] = "@raisedBlack@"
  bg[NORMAL]      = @bg_color
  bg[PRELIGHT]    = @selected_bg_color
  bg[SELECTED]    = @selected_bg_color

  fg[ACTIVE]      = @fg_color
  fg[INSENSITIVE] = "@secondaryText@"
  fg[NORMAL]      = @fg_color 
  fg[PRELIGHT]    = @selected_fg_color
  fg[SELECTED]    = @fg_color

  base[ACTIVE]      = @selected_bg_color #darker?
  base[INSENSITIVE] = "@raisedBlack@"
  base[NORMAL]      = @base_color
  base[PRELIGHT]    = @selected_bg_color
  base[SELECTED]    = @selected_bg_color

  text[ACTIVE]      = @text_color
  text[INSENSITIVE] = "@secondaryText@"
  text[NORMAL]      = @text_color
  text[PRELIGHT]    = @selected_fg_color
  text[SELECTED]    = @selected_fg_color

  engine "hcengine"
  {
    edge_thickness = 1 
    cell_indicator_size = 2
  }
}
class "GtkWidget"	style "default"

style "tooltips"
{
  fg[NORMAL]    = @tooltip_fg_color
  bg[NORMAL] 	= @tooltip_bg_color
}
widget "gtk-tooltip*" 	style "tooltips"

style "scroll"
{
  bg[NORMAL]      = "@foreground@"
  fg[NORMAL]      = "@background@"
  GtkScrollbar::slider-width         = 4
  GtkScrollbar::has-backward-stepper = 0
  GtkScrollbar::has-forward-stepper  = 0
}
class "GtkRange"	style "scroll"

style "button" 
{
  fg[NORMAL]      = "@foreground@" #gnome panel unselected
  fg[ACTIVE]      = @selected_fg_color #gnome panel focused  
}
class "GtkButton"      	style "button"

style "tab" 
{
  fg[NORMAL]      = @selected_fg_color
  fg[ACTIVE]      = "@foreground@" #inactive tab
}
class "GtkNotebook"      style "tab"

style "meta-frame"
{
  fg[SELECTED]  = @text_color #titlebar
  bg[SELECTED]  = @selected_bg_color

  fg[NORMAL]      = @text_color

  fg[ACTIVE]      = "@foreground@" #unselected titlebar text color (sometimes)
  fg[INSENSITIVE] = "@foreground@" #unselected titlebar controls color (sometimes text color too)
}
class "GtkWindow"      style "meta-frame"

style "border" 
{ fg[NORMAL]      = "@foreground@" }
class "GtkContainer"      style "border"

style "menuborder" 
{
  fg[NORMAL]      = @text_color
}
class "GtkMenuBar"      style "menuborder"
class "GtkMenu"      style "menuborder"
class "GtkFrame"      style "menuborder"

style "menu"
{
  fg[NORMAL]      = "@hot@"
}
class "GtkMenuItem"      style "menu"
class "GtkCheckButton"      style "menu"
class "GtkRadioButton"      style "menu"
class "GtkTreeView"   style "menu"

style "sep"
{
  #fg[NORMAL]      = "#00aaaa"
  fg[NORMAL]      = "@secondaryText@"
}
class "GtkSeparatorMenuItem" style "sep"
class "GtkSeparatorToolItem" style "sep"


widget "*.nautilus-extra-view-widget" style:highest "tooltips"
