#!/usr/bin/env bash
set -euo pipefail

if (($# != 3)); then
  printf 'usage: %s <claude|codex> <tab|right|down> <resume|new>\n' \
    "${0##*/}" >&2
  exit 2
fi

agent_kind=$1
placement=$2
session_mode=$3
case "$agent_kind" in
  claude | codex) ;;
  *)
    printf 'agent kind must be claude or codex\n' >&2
    exit 2
    ;;
esac
case "$placement" in
  tab | right | down) ;;
  *)
    printf 'placement must be tab, right, or down\n' >&2
    exit 2
    ;;
esac
case "$session_mode" in
  resume | new) ;;
  *)
    printf 'session mode must be resume or new\n' >&2
    exit 2
    ;;
esac

for required_command in herdr jq tr; do
  command -v "$required_command" >/dev/null 2>&1 || {
    printf 'herdr-agent-launch: %s is required\n' "$required_command" >&2
    exit 1
  }
done

socket_path=${HERDR_SOCKET_PATH:?HERDR_SOCKET_PATH is required}
workspace_id=${HERDR_ACTIVE_WORKSPACE_ID:-${HERDR_WORKSPACE_ID:-}}
pane_id=${HERDR_ACTIVE_PANE_ID:-${HERDR_PANE_ID:-}}
pane_cwd=${HERDR_ACTIVE_PANE_CWD:-$PWD}

if [[ -z $workspace_id || -z $pane_id ]]; then
  printf 'herdr-agent-launch: current Herdr pane and workspace are required\n' >&2
  exit 1
fi

export HERDR_SOCKET_PATH="$socket_path"
export HERDR_WORKSPACE_ID="$workspace_id"
export HERDR_PANE_ID="$pane_id"

if [[ $agent_kind == claude ]]; then
  orchestrator_prompt="$HOME/.config/claude/orchestrator-opus.md"
  if [[ ! -r $orchestrator_prompt ]]; then
    herdr notification show "Claude launch failed" \
      --body "Missing orchestrator prompt: $orchestrator_prompt" \
      --sound request >/dev/null 2>&1 || true
    printf 'herdr-agent-launch: missing orchestrator prompt: %s\n' \
      "$orchestrator_prompt" >&2
    exit 1
  fi
fi

case "$placement" in
  tab)
    before_state=$(herdr tab list --workspace "$workspace_id")
    before_ids=$(jq -ce '[.result.tabs[]?.tab_id]' <<<"$before_state")
    ;;
  right | down)
    before_state=$(herdr pane list --workspace "$workspace_id")
    before_ids=$(jq -ce '[.result.panes[]?.pane_id]' <<<"$before_state")
    ;;
esac

rollback_unparsed_destination() {
  local after_state discovered_id
  case "$placement" in
    tab)
      after_state=$(herdr tab list --workspace "$workspace_id") || return 1
      discovered_id=$(jq -er --argjson before "$before_ids" '
        [.result.tabs[]?.tab_id] - $before
        | select(length == 1)[0]
      ' <<<"$after_state") || return 1
      herdr tab close "$discovered_id" >/dev/null
      ;;
    right | down)
      after_state=$(herdr pane list --workspace "$workspace_id") || return 1
      discovered_id=$(jq -er --argjson before "$before_ids" '
        [.result.panes[]?.pane_id] - $before
        | select(length == 1)[0]
      ' <<<"$after_state") || return 1
      herdr pane close "$discovered_id" >/dev/null
      ;;
  esac
}

# HERDR_SCRIPTED_PANE makes the pane's zsh skip its login greeting
# (home/programs/print_welcome.sh), so the shell reaches a quiet prompt almost
# immediately instead of after a second-plus of fastfetch/poem output.
case "$placement" in
  tab)
    created=$(herdr tab create \
      --workspace "$workspace_id" \
      --cwd "$pane_cwd" \
      --env HERDR_SCRIPTED_PANE=1 \
      --no-focus)
    if ! new_tab_id=$(jq -er \
      '.result.tab.tab_id | select(type == "string" and length > 0)' \
      <<<"$created") \
      || ! new_pane_id=$(jq -er \
        '.result.root_pane.pane_id | select(type == "string" and length > 0)' \
        <<<"$created"); then
      rollback_unparsed_destination || true
      printf 'herdr-agent-launch: could not parse created tab response\n' >&2
      exit 1
    fi
    ;;
  right | down)
    created=$(herdr pane split \
      --current \
      --direction "$placement" \
      --cwd "$pane_cwd" \
      --env HERDR_SCRIPTED_PANE=1 \
      --no-focus)
    if ! new_pane_id=$(jq -er \
      '.result.pane.pane_id | select(type == "string" and length > 0)' \
      <<<"$created"); then
      rollback_unparsed_destination || true
      printf 'herdr-agent-launch: could not parse created pane response\n' >&2
      exit 1
    fi
    ;;
esac

rollback_destination() {
  case "$placement" in
    tab) herdr tab close "$new_tab_id" >/dev/null ;;
    right | down) herdr pane close "$new_pane_id" >/dev/null ;;
  esac
}

# Rolling back is only ever right for a destination that is still an empty idle
# shell. A destination the user already closed has nothing to remove and nothing
# to announce, and a destination with a foreground process in it may hold an
# agent Herdr has not classified yet or a `--resume` picker waiting on the user;
# tearing either down destroys live work.
destination_state() {
  local process_state
  herdr pane get "$new_pane_id" >/dev/null 2>&1 || {
    printf 'gone\n'
    return
  }
  process_state=$(herdr pane process-info --pane "$new_pane_id" 2>/dev/null) || {
    printf 'occupied\n'
    return
  }
  if jq -e '
    .result.process_info as $info
    | ($info.shell_pid | numbers) as $shell_pid
    | any($info.foreground_processes[]?; .pid != $shell_pid)
  ' <<<"$process_state" >/dev/null; then
    printf 'occupied\n'
  else
    printf 'idle\n'
  fi
}

# A command typed into a pane that is still running startup helpers is eaten:
# `herdr agent start` then returns only after its own startup timeout, which
# tears the destination down again. HERDR_SCRIPTED_PANE suppresses the login
# greeting, so the shell settles in ~0.3s; poll fast and require consecutive
# quiet polls so a momentary gap between helpers cannot read as ready.
wait_for_available_shell() {
  # 0.05s polls, 2 consecutive quiet, 0.2s settle; max_polls keeps the
  # previous ~20s overall budget (400 * 0.05).
  local poll_interval=0.05 max_polls=400 required_quiet_polls=2
  local poll quiet_polls=0 process_state
  for ((poll = 0; poll < max_polls; poll++)); do
    if process_state=$(herdr pane process-info --pane "$new_pane_id" 2>/dev/null) \
      && jq -e '
        .result.process_info as $info
        | ($info.shell_pid | numbers) as $shell_pid
        | all($info.foreground_processes[]?; .pid == $shell_pid)
      ' <<<"$process_state" >/dev/null; then
      quiet_polls=$((quiet_polls + 1))
      if ((quiet_polls >= required_quiet_polls)); then
        # Let the drawn prompt settle before Herdr looks at the pane.
        sleep 0.2
        return 0
      fi
    else
      quiet_polls=0
    fi
    sleep "$poll_interval"
  done
  return 1
}

if ! wait_for_available_shell; then
  if [[ $(destination_state) == gone ]]; then
    printf 'herdr-agent-launch: %s was closed before %s could be started\n' \
      "$new_pane_id" "$agent_kind" >&2
    exit 1
  fi
  rollback_destination || true
  herdr notification show "Agent launch failed" \
    --body "The new pane never reached an idle shell prompt, so $agent_kind was not started; its empty destination was removed." \
    --sound request >/dev/null 2>&1 || true
  printf 'herdr-agent-launch: %s never became an available shell\n' \
    "$new_pane_id" >&2
  exit 1
fi

pane_slug=$(printf '%s' "$new_pane_id" \
  | tr '[:upper:]' '[:lower:]' \
  | tr -cd 'a-z0-9_-')
agent_name="${agent_kind}-orch-${pane_slug}"
agent_name=${agent_name:0:32}

case "$agent_kind" in
  claude)
    agent_args=(
      --dangerously-skip-permissions
      --model claude-opus-5
      --append-system-prompt-file "$orchestrator_prompt"
    )
    if [[ $session_mode == resume ]]; then
      # With no value, --resume opens Claude's interactive session picker.
      agent_args+=(--resume)
    fi
    ;;
  codex)
    agent_args=(--profile orchestrator --yolo)
    if [[ $session_mode == resume ]]; then
      # With no session ID or --last, `resume` opens Codex's interactive picker.
      agent_args+=(resume)
    fi
    ;;
esac

if ! herdr agent start "$agent_name" \
  --kind "$agent_kind" \
  --pane "$new_pane_id" \
  -- "${agent_args[@]}"; then
  # A startup timeout is ambiguous: detection can finish between the timeout
  # and this check, so a detected agent always wins over any teardown.
  if agent_state=$(herdr agent get "$new_pane_id" 2>/dev/null) \
    && jq -e --arg kind "$agent_kind" \
      '.result.agent.agent == $kind' <<<"$agent_state" >/dev/null; then
    herdr agent focus "$new_pane_id"
    exit 0
  fi
  case "$(destination_state)" in
    gone)
      # `agent start` burns its full 30-second timeout when the pane it is
      # watching disappears, so this arrives long after the user closed the
      # destination themselves. There is nothing left to remove, and claiming a
      # failure they did not cause is the only thing a notification would add.
      printf 'herdr-agent-launch: %s was closed while %s was starting\n' \
        "$new_pane_id" "$agent_kind" >&2
      exit 1
      ;;
    occupied)
      herdr notification show "Agent launch still starting" \
        --body "Something is still running in $new_pane_id but Herdr has not detected $agent_kind yet; the destination was left alone." \
        --sound request >/dev/null 2>&1 || true
      exit 1
      ;;
  esac
  # An idle empty shell: remove only the destination this invocation created,
  # never pre-existing user layout.
  rollback_destination || true
  herdr notification show "Agent launch failed" \
    --body "The $agent_kind orchestrator did not start; its empty destination was removed." \
    --sound request >/dev/null 2>&1 || true
  exit 1
fi

# Keep the calling pane visible while the agent starts, then reveal the ready
# orchestrator so the function key behaves like a complete launch action.
herdr agent focus "$agent_name"
