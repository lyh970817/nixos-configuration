#!/usr/bin/env bash
set -euo pipefail

profiles_dir="${HYPRWHISPR_PROFILE_PROFILES_DIR:-$HOME/.config/hyprwhspr/profiles}"
state_home="${HYPRWHISPR_PROFILE_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}}"
runtime_dir="${HYPRWHISPR_PROFILE_RUNTIME_DIR:-${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required}/hyprwhspr}"
selector="${HYPRWHISPR_PROFILE_SELECTOR:-hyprwhispr-profile}"

mode_file="$state_home/hyprwhispr-profile/mode"
active_config="$runtime_dir/config.json"
expected_profile=""

if printf '4o\n' | cmp -s - "$mode_file"; then
  expected_profile="$profiles_dir/4o.json"
elif printf '4o-mini\n' | cmp -s - "$mode_file"; then
  expected_profile="$profiles_dir/4o-mini.json"
fi

if [[ -n "$expected_profile" && -L "$active_config" ]]; then
  active_target="$(readlink -f "$active_config")"
  expected_target="$(readlink -f "$expected_profile")"
  if [[ "$active_target" == "$expected_target" ]]; then
    exit 0
  fi
fi

exec "$selector" status >/dev/null
