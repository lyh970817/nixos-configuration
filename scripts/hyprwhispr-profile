#!/usr/bin/env bash
set -euo pipefail

readonly modes=(qwen-http qwen-ws qwen-omni qwen-realtime qwen-omni-realtime sensevoice realtime)
readonly default_mode=qwen-http
readonly profiles_dir="${HYPRWHISPR_PROFILE_PROFILES_DIR:?HYPRWHISPR_PROFILE_PROFILES_DIR is required}"
readonly state_home="${HYPRWHISPR_PROFILE_STATE_HOME:-${XDG_STATE_HOME:-$HOME/.local/state}}"
readonly runtime_dir="${HYPRWHISPR_PROFILE_RUNTIME_DIR:-${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is required}/hyprwhspr}"
readonly state_dir="$state_home/hyprwhispr-profile"
readonly state_file="$state_dir/mode"
readonly active_config="$runtime_dir/config.json"
readonly normal_service_name="${HYPRWHISPR_PROFILE_SERVICE:-hyprwhspr.service}"
readonly longform_service_name="${HYPRWHISPR_PROFILE_LONGFORM_SERVICE:-meeting-recorder.service}"

usage() {
  printf '%s\n' 'usage: hyprwhispr-profile {toggle|set qwen-http|set qwen-ws|set qwen-omni|set qwen-realtime|set qwen-omni-realtime|set sensevoice|set realtime|status}' >&2
}

is_mode() {
  local candidate="$1" mode
  for mode in "${modes[@]}"; do
    [[ "$candidate" == "$mode" ]] && return 0
  done
  return 1
}

next_mode() {
  local current="$1" count="${#modes[@]}" i next_index
  for ((i = 0; i < count; i++)); do
    if [[ "${modes[i]}" == "$current" ]]; then
      next_index=$(( (i + 1) % count ))
      printf '%s\n' "${modes[next_index]}"
      return 0
    fi
  done
  printf '%s\n' "$default_mode"
}

profile_path() {
  local mode="$1"
  printf '%s/%s.json\n' "$profiles_dir" "$mode"
}

stored_mode() {
  local mode
  if [[ -r "$state_file" ]]; then
    for mode in "${modes[@]}"; do
      if cmp -s "$state_file" <(printf '%s\n' "$mode"); then
        printf '%s\n' "$mode"
        return
      fi
    done
  fi
  printf '%s\n' "$default_mode"
}

write_mode() {
  local mode="$1"
  local temporary
  mkdir -p "$state_dir"
  temporary="$(mktemp "$state_dir/.mode.XXXXXX")"
  printf '%s\n' "$mode" > "$temporary"
  mv -f "$temporary" "$state_file"
}

activate_profile() {
  local mode="$1"
  local profile temporary
  profile="$(profile_path "$mode")"
  [[ -f "$profile" ]] || {
    printf '%s\n' "hyprwhispr-profile: immutable profile is unavailable" >&2
    return 1
  }
  mkdir -p "$runtime_dir"
  temporary="$(mktemp -u "$runtime_dir/.config.json.XXXXXX")"
  ln -sfn "$profile" "$temporary"
  mv -Tf "$temporary" "$active_config"
}

normal_activity() {
  local recording_file="$runtime_dir/recording_status"
  local visualizer_file="$runtime_dir/visualizer_state"
  if [[ -r "$recording_file" ]] && [[ "$(<"$recording_file")" == true ]]; then
    printf '%s\n' normal-recording
    return
  fi
  if [[ -r "$visualizer_file" ]]; then
    case "$(<"$visualizer_file")" in
      recording) printf '%s\n' normal-recording ;;
      processing) printf '%s\n' normal-processing ;;
    esac
  fi
}

longform_activity() {
  local response status_rc
  if ! systemctl --user is-active --quiet "$longform_service_name"; then
    return
  fi
  response="$(curl --fail --silent --show-error --max-time 1 http://127.0.0.1:"${HYPRWHISPR_PROFILE_LONGFORM_PORT:-8765}"/status 2>/dev/null)" || status_rc=$?
  if [[ -n "${status_rc:-}" ]]; then
    printf '%s\n' longform-processing
    return
  fi
  if [[ "$response" =~ \"recording\"[[:space:]]*:[[:space:]]*true ]]; then
    printf '%s\n' longform-recording
  fi
}

activity() {
  if [[ -n "${HYPRWHISPR_PROFILE_ACTIVITY_ADAPTER:-}" ]]; then
    "$HYPRWHISPR_PROFILE_ACTIVITY_ADAPTER"
  else
    normal_activity
    longform_activity
  fi
}

busy_reason() {
  local busy
  busy="$(activity || true)"
  if [[ -n "$busy" ]]; then
    printf '%s\n' "${busy%%$'\n'*}"
    return 0
  fi
  return 1
}

service() {
  local action="$1"
  local service_name="$2"
  local mode="$3"
  if [[ -n "${HYPRWHISPR_PROFILE_SERVICE_ADAPTER:-}" ]]; then
    "$HYPRWHISPR_PROFILE_SERVICE_ADAPTER" "$action" "$service_name" "$mode"
  elif [[ "$action" == restart ]]; then
    systemctl --user restart "$service_name"
  elif [[ "$action" == active ]]; then
    systemctl --user is-active --quiet "$service_name"
  elif [[ "$service_name" == "$normal_service_name" ]]; then
    daemon_ready "$mode"
  else
    longform_ready
  fi
}

daemon_ready() {
  local mode="$1"
  local profile attempts=40
  # Realtime websocket startup can take ~20s, including one daemon crash
  # plus systemd restart; give it a wider readiness window than the
  # rest-api-backed qwen-* profiles, which come up quickly.
  [[ "$mode" == realtime || "$mode" == qwen-realtime || "$mode" == qwen-omni-realtime ]] && attempts=120
  profile="$(readlink -f "$(profile_path "$mode")")"
  for _ in $(seq 1 "$attempts"); do
    if systemctl --user is-active --quiet "$normal_service_name" \
      && [[ "$(readlink -f "$active_config")" == "$profile" ]] \
      && XDG_CONFIG_HOME="${runtime_dir%/hyprwhspr}" hyprwhspr status >/dev/null 2>&1 \
      && [[ -p "$runtime_dir/recording_control" ]]; then
      return 0
    fi
    sleep 0.25
  done
  return 1
}

longform_ready() {
  for _ in $(seq 1 40); do
    if systemctl --user is-active --quiet "$longform_service_name" \
      && curl --fail --silent --show-error --max-time 1 http://127.0.0.1:"${HYPRWHISPR_PROFILE_LONGFORM_PORT:-8765}"/status >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.25
  done
  return 1
}

restart_services() {
  local mode="$1"
  local longform_was_active="$2"
  service restart "$normal_service_name" "$mode" \
    && service health "$normal_service_name" "$mode" \
    || return 1
  if [[ "$longform_was_active" == true ]]; then
    service restart "$longform_service_name" "$mode" \
      && service health "$longform_service_name" "$mode" \
      || return 1
  fi
}

notify() {
  local title="$1"
  local body="$2"
  if [[ -n "${HYPRWHISPR_PROFILE_NOTIFY_ADAPTER:-}" ]]; then
    "$HYPRWHISPR_PROFILE_NOTIFY_ADAPTER" "$title" "$body"
  else
    notify-send "$title" "$body"
  fi
}

ensure_current_profile() {
  local mode
  mode="$(stored_mode)"
  write_mode "$mode"
  activate_profile "$mode"
  printf '%s\n' "$mode"
}

profile_is_current() {
  local mode="$1"
  local expected
  cmp -s "$state_file" <(printf '%s\n' "$mode") || return 1
  [[ -L "$active_config" ]] || return 1
  expected="$(readlink -f "$(profile_path "$mode")")"
  [[ "$(readlink -f "$active_config")" == "$expected" ]]
}

refuse_if_busy() {
  local mode="$1"
  local busy
  if busy="$(busy_reason)"; then
    notify 'Hyprwhispr profile unchanged' "Current profile is $mode; dictation is busy ($busy)." || true
    printf '%s\n' "hyprwhispr-profile: dictation is busy ($busy); profile unchanged" >&2
    return 0
  fi
  return 1
}

status_profile() {
  local mode longform_was_active=false
  mode="$(stored_mode)"
  if profile_is_current "$mode"; then
    printf '%s\n' "$mode"
    return 0
  fi
  if refuse_if_busy "$mode"; then
    return 3
  fi
  mode="$(ensure_current_profile)" || return 1
  if service active "$normal_service_name" "$mode"; then
    if service active "$longform_service_name" "$mode"; then
      longform_was_active=true
    fi
    if ! restart_services "$mode" "$longform_was_active"; then
      printf '%s\n' 'hyprwhispr-profile: repaired profile activation but could not reload the running service' >&2
      return 1
    fi
  fi
  printf '%s\n' "$mode"
}

change_profile() {
  local requested="$1"
  local previous longform_was_active=false restored=true
  is_mode "$requested" || {
    printf '%s\n' "hyprwhispr-profile: unknown profile '$requested'; expected one of: ${modes[*]}" >&2
    return 2
  }
  [[ -f "$(profile_path "$requested")" ]] || {
    printf '%s\n' 'hyprwhispr-profile: requested immutable profile is unavailable' >&2
    return 1
  }
  previous="$(stored_mode)"
  if refuse_if_busy "$previous"; then
    return 3
  fi
  if ! previous="$(ensure_current_profile)"; then
    printf '%s\n' 'hyprwhispr-profile: unable to prepare the current profile' >&2
    return 1
  fi
  if service active "$longform_service_name" "$previous"; then
    longform_was_active=true
  fi
  if refuse_if_busy "$previous"; then
    return 3
  fi
  write_mode "$requested"
  if activate_profile "$requested" && restart_services "$requested" "$longform_was_active"; then
    notify 'Hyprwhispr profile active' "$requested" || true
    printf '%s\n' "$requested"
    return 0
  fi
  # Fail loudly: the user wants a failed backend visible, not silently
  # masked. Roll back to the previously active profile so dictation keeps
  # working while the failure is investigated.
  notify 'Hyprwhispr profile change failed' "$requested backend failed to come up; rolling back to $previous." || true
  printf '%s\n' "hyprwhispr-profile: $requested backend failed to come up; rolling back to $previous" >&2
  write_mode "$previous" || restored=false
  activate_profile "$previous" || restored=false
  if [[ "$restored" == true ]]; then
    restart_services "$previous" "$longform_was_active" || restored=false
  fi
  if [[ "$restored" == true ]]; then
    notify 'Hyprwhispr profile change failed' "Restored $previous" || true
    printf '%s\n' "hyprwhispr-profile: restart failed; restored $previous" >&2
  else
    notify 'Hyprwhispr profile change failed' 'Recovery needs attention' || true
    printf '%s\n' 'hyprwhispr-profile: restart failed; recovery needs attention' >&2
  fi
  return 1
}

main() {
  local command="${1:-}"
  case "$command" in
    status)
      [[ $# == 1 ]] || { usage; return 2; }
      status_profile
      ;;
    toggle)
      [[ $# == 1 ]] || { usage; return 2; }
      change_profile "$(next_mode "$(stored_mode)")"
      ;;
    set)
      [[ $# == 2 ]] || { usage; return 2; }
      change_profile "$2"
      ;;
    *)
      usage
      return 2
      ;;
  esac
}

mkdir -p "$state_home"
exec 9>"${state_home}/hyprwhispr-profile.lock"
flock -x 9
main "$@"
