#!/usr/bin/env bash
set -euo pipefail

# Which engine owns short dictation on Super+O: hyprwhspr (the default) or one
# of the app engines below. Ctrl+Shift+P steps through hyprwhspr's profiles,
# then each app engine in turn, and from the last one back to the first
# hyprwhspr profile.
#
# The app engines have no command to start or stop dictation; each reads its
# own trigger (set to Super+O in its settings) straight from evdev, so in their
# mode the Hyprland bind only swallows the key. Each runs as <engine>.service,
# started only while selected. Long-form dictation (Ctrl+Shift+L) stays on
# hyprwhspr either way.

readonly app_engines=(doubao-say typeless wispr-flow)
readonly state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/dictation-engine"
readonly state_file="$state_dir/engine"
readonly hyprwhspr_runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hyprwhspr"
readonly first_profile=qwen-omni-realtime
readonly last_profile=qwen-audio3

usage() {
  printf '%s\n' 'usage: dictation-engine {toggle|record|current|is ENGINE}' >&2
}

current() {
  local stored engine
  if [[ -r $state_file ]]; then
    stored="$(< "$state_file")"
    for engine in "${app_engines[@]}"; do
      if [[ $stored == "$engine" ]]; then
        printf '%s\n' "$engine"
        return
      fi
    done
  fi
  printf '%s\n' hyprwhspr
}

# The app engine after $1, or nothing after the last one.
next_app_engine() {
  local i count="${#app_engines[@]}"
  for ((i = 0; i < count - 1; i++)); do
    if [[ ${app_engines[i]} == "$1" ]]; then
      printf '%s\n' "${app_engines[i + 1]}"
      return
    fi
  done
}

write_engine() {
  local temporary
  mkdir -p "$state_dir"
  temporary="$(mktemp "$state_dir/.engine.XXXXXX")"
  printf '%s\n' "$1" > "$temporary"
  mv -f "$temporary" "$state_file"
}

# The same two files scripts/hyprwhispr-record consults.
hyprwhspr_recording() {
  [[ -r $hyprwhspr_runtime/recording_status && $(< "$hyprwhspr_runtime/recording_status") == true ]] && return 0
  [[ -r $hyprwhspr_runtime/visualizer_state && $(< "$hyprwhspr_runtime/visualizer_state") == recording ]] && return 0
  return 1
}

to_hyprwhspr() {
  write_engine hyprwhspr
  # Announces the profile it lands on.
  hyprwhispr-profile set "$first_profile"
}

to_app_engine() {
  local engine="$1"
  write_engine "$engine"
  if systemctl --user start "$engine.service"; then
    notify-send 'Dictation engine active' "$engine" || true
    return 0
  fi
  notify-send 'Dictation engine change failed' "$engine did not start; back to hyprwhspr." || true
  to_hyprwhspr
  return 1
}

toggle() {
  local engine next
  mkdir -p "$state_dir"
  exec 9> "$state_dir/.lock"
  flock -x 9
  engine="$(current)"
  if [[ $engine == hyprwhspr ]]; then
    if [[ $(hyprwhispr-profile status 2> /dev/null) != "$last_profile" ]]; then
      hyprwhispr-profile toggle
      return
    fi
    # Super+O would stop reaching hyprwhspr mid-recording.
    if hyprwhspr_recording; then
      notify-send 'Dictation engine unchanged' 'hyprwhspr is recording.' || true
      return 3
    fi
    to_app_engine "${app_engines[0]}"
    return
  fi
  systemctl --user stop "$engine.service" || true
  next="$(next_app_engine "$engine")"
  if [[ -n $next ]]; then
    to_app_engine "$next"
  else
    to_hyprwhspr
  fi
}

record() {
  local engine
  engine="$(current)"
  if [[ $engine == hyprwhspr ]]; then
    exec hyprwhispr-record toggle
  fi
  if ! systemctl --user is-active --quiet "$engine.service"; then
    notify-send "$engine is not running" 'Ctrl+Shift+P switches to the next dictation engine.' || true
    return 1
  fi
}

main() {
  case "${1:-}" in
    toggle | record | current)
      [[ $# == 1 ]] || { usage; return 2; }
      "$1"
      ;;
    is)
      [[ $# == 2 ]] || { usage; return 2; }
      [[ $(current) == "$2" ]]
      ;;
    *)
      usage
      return 2
      ;;
  esac
}

main "$@"
