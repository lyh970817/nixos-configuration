#!/usr/bin/env bash
# Fork the focused Claude session into an explanation workspace, out-of-band:
# nothing is typed into the agent and its transcript is untouched. Bound to f7
# in dotfiles/herdr/config.toml. Resolves the pane's Claude session from
# Herdr, the launcher profile from the silent SessionStart mapping written by
# dotfiles/claude/hooks/explain-session-register.sh, then opens the explain
# Neovim workspace in a new Herdr tab, which prompts for the question and
# calls `explainctl new` itself (see the handshake in the explain Neovim
# module). A Herdr tab rather than a detached GUI window: the herdr server
# may have no display environment (started over SSH), and a window on this
# machine's monitor is invisible when the user drives from the laptop. The
# terminal hosting the Herdr client (kitty on both hosts) renders the math
# images, so no display-env derivation is needed here.
set -euo pipefail

notify() {
  herdr notification show "$1" --body "$2" --sound request >/dev/null 2>&1 || true
  printf 'herdr-explain-current: %s: %s\n' "$1" "$2" >&2
}

for required_command in herdr jq nvim; do
  command -v "$required_command" >/dev/null 2>&1 || {
    notify "Explain failed" "$required_command is required"
    exit 1
  }
done

pane_id=${HERDR_ACTIVE_PANE_ID:-${HERDR_PANE_ID:-}}
pane_cwd=${HERDR_ACTIVE_PANE_CWD:-$PWD}
if [[ -z $pane_id ]]; then
  notify "Explain failed" "no active Herdr pane"
  exit 1
fi

if ! agent_json=$(herdr agent get "$pane_id" 2>&1); then
  notify "Explain failed" "focused pane has no agent"
  exit 1
fi

agent_kind=$(jq -r '.result.agent.agent // empty' <<<"$agent_json")
if [[ $agent_kind != claude ]]; then
  notify "Explain failed" "focused pane is not a Claude agent"
  exit 1
fi

# Forking during a partially written turn risks an incomplete snapshot, so
# only a settled agent may be forked; trigger again once the turn finishes.
agent_status=$(jq -r '.result.agent.agent_status // empty' <<<"$agent_json")
case "$agent_status" in
  idle | done) ;;
  *)
    notify "Claude is still working" \
      "status: ${agent_status:-unknown}; trigger again after the turn finishes"
    exit 1
    ;;
esac

session_id=$(jq -r '.result.agent.agent_session.value // empty' <<<"$agent_json")
if [[ -z $session_id ]]; then
  notify "Explain failed" "no Claude session recorded for this pane"
  exit 1
fi

# Launcher and true working directory from the per-pane registration, when it
# matches the session Herdr reports (a /resume may have replaced the session
# since an old record was written). Herdr does not retain the launcher.
uid=$(id -u)
runtime_dir=${XDG_RUNTIME_DIR:-/run/user/$uid}
mapping="$runtime_dir/explain-session/by-pane/${pane_id//\//_}.json"
launcher=""
origin_cwd=$(jq -r '.result.agent.cwd // empty' <<<"$agent_json")
if [[ -f $mapping ]]; then
  mapped_session=$(jq -r '.session_id // empty' "$mapping" 2>/dev/null || true)
  if [[ $mapped_session == "$session_id" ]]; then
    launcher=$(jq -r '.launcher // empty' "$mapping" 2>/dev/null || true)
    mapped_cwd=$(jq -r '.cwd // empty' "$mapping" 2>/dev/null || true)
    [[ -n $mapped_cwd ]] && origin_cwd=$mapped_cwd
  fi
fi
# Without a registration record the standard launcher is the safe default.
[[ -n $launcher ]] || launcher=claude
[[ -n $origin_cwd ]] || origin_cwd=$pane_cwd

# The question is entered in the workspace itself: Neovim sees these
# variables (set on the tab at creation so its whole process tree inherits
# them), prompts, and runs
#   explainctl new --session-id ... --cwd ... --launcher ... --question ... \
#     --no-open
workspace_id=${HERDR_ACTIVE_WORKSPACE_ID:-${HERDR_WORKSPACE_ID:-}}

# Label the tab with the origin session's project so several explanation tabs
# stay tellable apart. Herdr renders tab labels at full width — no ellipsis,
# a long label just crowds the bar until it scrolls (ui/tabs.rs tab_width) —
# so truncate here; degenerate cwds fall back to the plain label.
tab_label=Explanation
origin_base=$(basename -- "$origin_cwd")
if [[ -n $origin_base && $origin_base != / && $origin_base != . ]]; then
  if ((${#origin_base} > 24)); then
    origin_base="${origin_base:0:23}…"
  fi
  tab_label="Explain: $origin_base"
fi

tab_args=(
  --cwd "$origin_cwd"
  --label "$tab_label"
  --focus
  # Skip the pane's login greeting (home/programs/print_welcome.sh) so the
  # shell reaches a quiet prompt fast and nvim starts sooner.
  --env HERDR_SCRIPTED_PANE=1
  --env EXPLAIN_ORIGIN_SESSION_ID="$session_id"
  --env EXPLAIN_ORIGIN_CWD="$origin_cwd"
  --env EXPLAIN_ORIGIN_LAUNCHER="$launcher"
)
if [[ -n $workspace_id ]]; then
  tab_args+=(--workspace "$workspace_id")
fi

if ! created=$(herdr tab create "${tab_args[@]}" 2>&1); then
  notify "Explain failed" "could not create the explanation tab"
  exit 1
fi
if ! tab_id=$(jq -er \
  '.result.tab.tab_id | select(type == "string" and length > 0)' \
  <<<"$created") \
  || ! new_pane_id=$(jq -er \
    '.result.root_pane.pane_id | select(type == "string" and length > 0)' \
    <<<"$created"); then
  notify "Explain failed" "created tab response was unparseable"
  exit 1
fi

# Only the shell itself in the foreground counts as ready: a command typed
# while startup helpers still run is eaten (same hazard as
# scripts/herdr-agent-launch). HERDR_SCRIPTED_PANE suppresses the greeting, so
# the shell settles in ~0.3s; poll fast and require consecutive quiet polls so
# a momentary gap between helpers cannot read as ready.
shell_is_idle() {
  local process_state
  process_state=$(herdr pane process-info --pane "$new_pane_id" 2>/dev/null) \
    || return 1
  jq -e '
    .result.process_info as $info
    | ($info.shell_pid | numbers) as $shell_pid
    | (all($info.foreground_processes[]?; .pid == $shell_pid))
      and ([$info.foreground_processes[]?] | length > 0)
  ' <<<"$process_state" >/dev/null
}

wait_for_available_shell() {
  # 0.05s polls, 2 consecutive quiet, 0.2s settle; max_polls keeps the
  # previous ~15s overall budget (300 * 0.05).
  local poll_interval=0.05 max_polls=300 required_quiet_polls=2
  local poll quiet_polls=0
  for ((poll = 0; poll < max_polls; poll++)); do
    if shell_is_idle; then
      quiet_polls=$((quiet_polls + 1))
      if ((quiet_polls >= required_quiet_polls)); then
        sleep 0.2
        return 0
      fi
    else
      quiet_polls=0
    fi
    sleep "$poll_interval"
  done
  return 1
}

# The tab is removed only while it is still a lone idle shell — that removal
# destroys nothing, and leaving it would look like silent success. A busy or
# vanished pane is left alone; the notification still reports the failure.
fail_tab() {
  if herdr tab get "$tab_id" >/dev/null 2>&1 && shell_is_idle; then
    herdr tab close "$tab_id" >/dev/null 2>&1 || true
  fi
  notify "Explain failed" "$1"
  exit 1
}

wait_for_available_shell \
  || fail_tab "the explanation tab never reached an idle shell"

# exec so quitting Neovim closes the tab, like the old dedicated window.
herdr pane run "$new_pane_id" exec nvim >/dev/null 2>&1 \
  || fail_tab "could not start nvim in the explanation tab"

# The old window spawn failed silently; verify the editor actually came up.
nvim_running() {
  local process_state
  process_state=$(herdr pane process-info --pane "$new_pane_id" 2>/dev/null) \
    || return 1
  jq -e '
    any(.result.process_info.foreground_processes[]?; .name == "nvim")
  ' <<<"$process_state" >/dev/null
}

for ((poll = 0; poll < 40; poll++)); do
  if nvim_running; then
    exit 0
  fi
  sleep 0.25
done
fail_tab "nvim did not start in the explanation tab"
