#!/usr/bin/env bash
set -euo pipefail

if (($# != 1)); then
  printf 'usage: %s <tab-number 1-9>\n' "${0##*/}" >&2
  exit 2
fi

number=$1
case "$number" in
  [1-9]) ;;
  *)
    printf 'tab number must be between 1 and 9\n' >&2
    exit 2
    ;;
esac

fail() {
  printf 'herdr-select-or-create-tab: %s\n' "$*" >&2
  exit 1
}

for required_command in herdr jq flock; do
  command -v "$required_command" >/dev/null 2>&1 ||
    fail "$required_command is required"
done

if [[ -n ${XDG_STATE_HOME:-} ]]; then
  state_home=$XDG_STATE_HOME
else
  [[ -n ${HOME:-} ]] || fail 'HOME is required when XDG_STATE_HOME is unset'
  state_home="$HOME/.local/state"
fi

case "$state_home" in
  /*) ;;
  *) fail 'XDG_STATE_HOME must be an absolute path' ;;
esac

state_dir="$state_home/herdr"
state_file="$state_dir/tab-slots.json"
lock_file="$state_dir/tab-slots.lock"

umask 077
mkdir -p -- "$state_dir"
chmod 700 -- "$state_dir"

[[ ! -L "$state_file" ]] || fail "refusing symbolic-link state file: $state_file"
[[ ! -e "$state_file" || -f "$state_file" ]] ||
  fail "state path is not a regular file: $state_file"

exec {lock_fd}>>"$lock_file"
flock -x "$lock_fd"

temporary_state=
cleanup() {
  [[ -z ${temporary_state:-} ]] || rm -f -- "$temporary_state"
}
trap cleanup EXIT

if [[ -n ${HERDR_ACTIVE_WORKSPACE_ID:-} ]]; then
  workspace_id=$HERDR_ACTIVE_WORKSPACE_ID
elif [[ -n ${HERDR_WORKSPACE_ID:-} ]]; then
  workspace_id=$HERDR_WORKSPACE_ID
else
  if ! workspaces=$(herdr workspace list); then
    fail 'could not list Herdr workspaces'
  fi
  if ! workspace_id=$(jq -er '
    [.result.workspaces[]? | select(.focused == true) | .workspace_id] as $ids
    | if (($ids | length) == 1
          and (($ids[0] | type) == "string")
          and (($ids[0] | length) > 0))
      then $ids[0]
      else error("expected exactly one focused workspace")
      end
  ' <<<"$workspaces"); then
    fail 'could not determine the focused Herdr workspace'
  fi
fi

if [[ -e "$state_file" ]]; then
  if ! state=$(jq -ce '
    def slot_map:
      type == "object"
      and all(
        to_entries[];
        (.key | test("^[1-9]$"))
        and ((.value | type) == "string")
        and ((.value | length) > 0)
      )
      and (([.[]] | unique | length) == ([.[]] | length));
    if (
      type == "object"
      and .version == 1
      and ((.workspaces | type) == "object")
      and all(
        .workspaces | to_entries[];
        ((.key | length) > 0) and (.value | slot_map)
      )
    ) then .
    else error("expected version 1 workspace slot map")
    end
  ' "$state_file"); then
    fail "refusing invalid state file: $state_file"
  fi
else
  state='{"version":1,"workspaces":{}}'
fi

persist_slot() {
  local updated_state

  if ! updated_state=$(jq -ce \
    --arg workspace "$workspace_id" \
    --arg slot "$number" \
    --arg tab_id "$tab_id" '
    .workspaces[$workspace] = (.workspaces[$workspace] // {})
    | .workspaces[$workspace][$slot] = $tab_id
  ' <<<"$state"); then
    fail 'could not update the tab slot state'
  fi

  if ! temporary_state=$(mktemp "$state_dir/.tab-slots.json.XXXXXX"); then
    fail "could not create temporary state file in $state_dir"
  fi
  printf '%s\n' "$updated_state" >"$temporary_state"
  chmod 600 -- "$temporary_state"
  mv -f -- "$temporary_state" "$state_file"
  temporary_state=
  state=$updated_state
}

if ! tab_id=$(jq -r --arg workspace "$workspace_id" --arg slot "$number" '
  .workspaces[$workspace][$slot] // empty
' <<<"$state"); then
  fail 'could not read the tab slot state'
fi

load_tabs() {
  if ! tabs=$(herdr tab list --workspace "$workspace_id"); then
    return 1
  fi
  jq -e '
    if (
      ((.result.tabs | type) == "array")
      and all(
        .result.tabs[];
        ((.tab_id | type) == "string")
        and ((.workspace_id | type) == "string")
        and (
          .number
          | (type == "number" and floor == . and . > 0)
        )
      )
    ) then .
    else error("invalid tab list")
    end
  ' <<<"$tabs" >/dev/null
}

tab_is_live() {
  jq -e --arg workspace "$workspace_id" --arg tab_id "$tab_id" '
    any(
      .result.tabs[];
      .tab_id == $tab_id and .workspace_id == $workspace
    )
  ' <<<"$tabs" >/dev/null
}

tab_with_public_number() {
  jq -r --arg workspace "$workspace_id" --argjson slot "$number" '
    [
      .result.tabs[]
      | select(.workspace_id == $workspace and .number == $slot)
      | .tab_id
    ] as $tab_ids
    | if ($tab_ids | length) == 0 then ""
      elif ($tab_ids | length) == 1 then $tab_ids[0]
      else error("duplicate public tab number")
      end
  ' <<<"$tabs"
}

tab_is_mapped_to_another_slot() {
  jq -e \
    --arg workspace "$workspace_id" \
    --arg slot "$number" \
    --arg tab_id "$tab_id" '
    any(
      (.workspaces[$workspace] // {}) | to_entries[];
      .key != $slot and .value == $tab_id
    )
  ' <<<"$state" >/dev/null
}

if ! load_tabs; then
  fail "could not list tabs for workspace $workspace_id"
fi

if [[ -n "$tab_id" ]] && tab_is_live; then
  if herdr tab focus "$tab_id"; then
    exit 0
  fi

  # A tab can close between the list and focus calls. Retry only when the
  # mapping is now stale; otherwise preserve the mapping and report the error.
  if ! load_tabs; then
    fail "could not revalidate tab slot $number in workspace $workspace_id"
  fi
  if tab_is_live; then
    fail "could not focus mapped tab $tab_id"
  fi
fi

# A missing or stale mapping can still have a deterministic live owner. Herdr
# assigns public tab numbers per workspace, keeps them stable, and never reuses
# them after close; persist the opaque tab ID once it is adopted.
if ! adopted_tab_id=$(tab_with_public_number); then
  fail "could not identify public tab number $number in workspace $workspace_id"
fi
if [[ -n "$adopted_tab_id" ]]; then
  tab_id=$adopted_tab_id
  if tab_is_mapped_to_another_slot; then
    fail "public tab $tab_id is already assigned to another slot"
  fi
  if herdr tab focus "$tab_id"; then
    persist_slot
    exit 0
  fi

  # As above, only create after proving the adopted tab disappeared.
  if ! load_tabs; then
    fail "could not revalidate adopted tab slot $number in workspace $workspace_id"
  fi
  if tab_is_live; then
    fail "could not focus adopted tab $tab_id"
  fi
fi

if ! created=$(herdr tab create --workspace "$workspace_id" --label "$number" --focus); then
  fail "could not create tab slot $number in workspace $workspace_id"
fi
if ! tab_id=$(jq -er --arg workspace "$workspace_id" '
  .result
  | if (
      .type == "tab_created"
      and (.tab | type) == "object"
      and ((.tab.tab_id | type) == "string")
      and ((.tab.tab_id | length) > 0)
      and (.tab.workspace_id == $workspace)
    ) then .tab.tab_id
    else error("invalid tab creation response")
    end
' <<<"$created"); then
  fail 'could not read the created tab ID'
fi

if ! created_info=$(herdr tab get "$tab_id"); then
  fail "created tab $tab_id but could not validate it"
fi
if ! jq -e --arg workspace "$workspace_id" --arg tab_id "$tab_id" '
  .result.tab
  | (
      (.tab_id == $tab_id)
      and (.workspace_id == $workspace)
    )
' <<<"$created_info" >/dev/null; then
  fail "created tab $tab_id did not validate for workspace $workspace_id"
fi

persist_slot
