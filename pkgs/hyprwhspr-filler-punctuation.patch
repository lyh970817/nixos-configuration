+    @staticmethod
+    def _close_filler_gap(match) -> str:
+        """Rejoin text around a removed clause-leading filler word"""
+        lead = match.group(1)
+        trail = match.group(2) or ''
+        follower = match.group(3)
+        if lead and lead[0] in ',;:' and trail in ('.', '!', '?'):
+            # The filler carried the clause's sentence-ending mark
+            # ("check it, um?"): keep the ender, drop the separator
+            lead = trail + lead[1:]
+        if not lead or lead[0] in '.!?':
+            # The follower starts a sentence now that the filler is gone
+            follower = follower.upper()
+        return lead + follower
