+    def _wait_for_realtime_connect(self, timeout: float = 8.0) -> bool:
+        """Wait out an in-flight realtime connect instead of tearing it down."""
+        client = self._realtime_client
+        if not client:
+            return False
+        if client.connected:
+            return True
+        if not getattr(client, 'connecting', False):
+            return False
+        print('[REALTIME] Connection handshake in flight; waiting...', flush=True)
+        deadline = time.monotonic() + timeout
+        while time.monotonic() < deadline:
+            if client.connected:
+                print('[REALTIME] In-flight connection completed', flush=True)
+                return True
+            if not getattr(client, 'connecting', False):
+                break
+            time.sleep(0.1)
+        return client.connected
+
